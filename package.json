{
  "name": "@eddieparc/senpi-accounts",
  "version": "0.5.1",
  "description": "OMO addon for Kiro account routing plus OpenGateway and TokenRouter providers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddieparc/omo-accounts.git"
  },
  "homepage": "https://github.com/eddieparc/omo-accounts#readme",
  "bugs": {
    "url": "https://github.com/eddieparc/omo-accounts/issues"
  },
  "keywords": [
    "pi-package",
    "omo",
    "omo-extension",
    "senpi",
    "kiro",
    "opengateway",
    "tokenrouter",
    "multi-account",
    "provider-accounts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "[ -f tsconfig.build.json ] && npm run build || exit 0",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@code-yeongyu/senpi": ">=2026.8.31"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@code-yeongyu/senpi": "2026.8.31",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
